  "labels": {
    "colourFinish": { "LM": "Light-matte", "ET": "Earth-textured", "CG": "Chromatic-glossy", "DG": "Dark-glossy / metallic" },
    "typography": { "SA": "Sans-serif", "SC": "Script / ornamental", "SE": "Serif" },
